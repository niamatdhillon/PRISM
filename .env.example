# Copy to .env (never commit .env). Placeholders only.
PRISM_ENV=development                 # production enables Secure cookies, disables /api/docs
DATABASE_URL=                         # empty = SQLite in ./var ; e.g. postgresql://user:pass@host:5432/prism
PRISM_VAR_DIR=                        # runtime files (sqlite, FAISS index, dataset features); default ./var
PRISM_COOKIE_SECURE=                  # 1 behind HTTPS (default 1 in production)
PRISM_ADMIN_SESSION_HOURS=8
OLLAMA_HOST=http://127.0.0.1:11434    # loopback only unless PRISM_ALLOW_REMOTE_OLLAMA=1 (private networks only)
OLLAMA_MODEL=                         # e.g. qwen2.5:3b ; empty = first installed model
OLLAMA_TIMEOUT_S=120
PRISM_EMBEDDINGS=auto                 # auto = sentence-transformers if installed ; lsa = light fallback
PRISM_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
PRISM_EEGMAT_DIR=                     # default ./datasets_cache/eegmat
# Admin passwords are NEVER set here: use `python -m backend.cli create-admin EMAIL`.
