# Copy to .env (never commit .env). Placeholders only.
# PRISM_MODE=local            # local | hosted (hosted is selected automatically on Vercel)
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=               # e.g. a model you have already pulled; empty = first installed model
# PRISM_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
# PRISM_EMBEDDINGS=auto       # auto | lsa (lsa = lightweight, no neural model)
# PRISM_DB=data/prism.sqlite3
